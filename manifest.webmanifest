{
  "name": "MickleCade",
  "short_name": "MickleCade",
  "description": "The MickleKids arcade: little games to play in the browser.",
  "start_url": "launcher/index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#120b28",
  "theme_color": "#120b28",
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
